# Datos de referencia / cliente — nunca versionar
/INPUT/

# Config local (contiene rutas específicas de cada máquina/usuario)
/config/config.json

# Outputs generados en cada corrida (JSON de contratos, oportunidades, reportes, logs de email)
/output/**
!/output/.gitkeep
!/output/**/.gitkeep

# Documentos de datos (contratos, dossiers) por si se copian dentro del repo por error
*.pdf
*.docx
*.pptx
*.xlsx
*.xls
!skills/**/assets/*.html

# Sistema / entornos
.DS_Store
__pycache__/
*.pyc
.venv/
node_modules/

# Evals / workspaces de skill-creator si se usan localmente
*-workspace/

# QA temporal de scripts (datos sintéticos, nunca material del plugin)
/_tmp_qa/

# Build artifact del plugin (se genera con `zip` para subir a Cowork/Customize, no es fuente).
# Versionado por nombre de archivo (savings-engine-plugin-v<version>.zip), no por git — ver
# "Versionado del .zip" en README.md. El patrón cubre tanto el nombre viejo sin versión como
# cualquier build versionado.
/savings-engine-plugin.zip
/savings-engine-plugin-v*.zip
/savings-engine-plugin/
