{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CategoryContractExtraction",
  "description": "Esquema v3 para el JSON consolidado de una categoría (metadata + arreglo de contratos). Ver schema.md para la descripción completa de cada campo. Mirror del formato usado por INPUT/playbooks/01_extraccion_contratos.md v3.",
  "type": "object",
  "required": ["metadata", "contratos"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["categoria", "fecha_extraccion", "version", "total_contratos"],
      "properties": {
        "categoria": { "type": "string" },
        "fecha_extraccion": { "type": "string", "format": "date" },
        "cliente": { "type": ["string", "null"] },
        "metodologia": { "type": ["string", "null"] },
        "version": { "type": "string" },
        "version_anterior": { "type": ["string", "null"] },
        "total_contratos": { "type": "integer" },
        "nota_normalizacion": { "type": ["string", "null"] }
      }
    },
    "contratos": {
      "type": "array",
      "items": { "$ref": "#/definitions/contrato" }
    }
  },
  "definitions": {
    "campo_con_trazabilidad": {
      "type": "object",
      "description": "Envoltorio mínimo de trazabilidad. Implementaciones reales pueden anidar más sub-campos (detalle, existe, validacion_digito_verificador, etc.) — este objeto solo exige el mínimo.",
      "properties": {
        "valor": {},
        "fuente": { "type": ["string", "null"] },
        "confianza": { "enum": ["alta", "media", "baja", null] }
      }
    },
    "monto": {
      "type": "object",
      "required": ["moneda", "valor", "periodo"],
      "properties": {
        "moneda": { "type": "string" },
        "valor": { "type": "number" },
        "periodo": { "type": "string" }
      }
    },
    "contrato": {
      "type": "object",
      "required": [
        "numero_contrato",
        "proveedor",
        "rut_run_proveedor",
        "vigencia",
        "monto_total",
        "documentos_fuente"
      ],
      "properties": {
        "numero_contrato": { "type": "string" },
        "proveedor": { "type": "string" },
        "rut_run_proveedor": {
          "type": "object",
          "required": ["valor"],
          "properties": {
            "valor": { "type": "string" },
            "validacion_digito_verificador": { "type": "object" },
            "fuente": { "type": ["string", "null"] },
            "confianza": { "enum": ["alta", "media", "baja", null] }
          }
        },
        "vigencia": {
          "type": "object",
          "properties": {
            "fecha_inicio": { "$ref": "#/definitions/campo_con_trazabilidad" },
            "fecha_fin": { "$ref": "#/definitions/campo_con_trazabilidad" },
            "renovacion_automatica_tacita": { "type": "object" },
            "renovacion_automatica": { "type": "object" },
            "termino_anticipado": { "type": "object" }
          }
        },
        "monto_total": {
          "description": "Puede venir como objeto {valor:[...],nota,fuente,confianza} o directamente como lista [{moneda,valor,periodo}] — tolerar ambas formas (ver nota de variabilidad entre sub-agentes en schema.md) pero normalizar a la forma objeto al consolidar.",
          "anyOf": [
            {
              "type": "object",
              "required": ["valor"],
              "properties": {
                "valor": { "type": "array", "items": { "$ref": "#/definitions/monto" } },
                "nota": { "type": ["string", "null"] },
                "fuente": { "type": ["string", "null"] },
                "confianza": { "enum": ["alta", "media", "baja", null] }
              }
            },
            {
              "type": "array",
              "items": { "$ref": "#/definitions/monto" }
            }
          ]
        },
        "tipo_cambio": { "type": ["object", "null"] },
        "productos_servicios_costo_unitario": {
          "type": "object",
          "properties": {
            "descripcion_cantidad": { "type": "array" },
            "costo_unitario": { "type": "array" }
          }
        },
        "metodo_pago": { "$ref": "#/definitions/campo_con_trazabilidad" },
        "niveles_servicio": { "$ref": "#/definitions/campo_con_trazabilidad" },
        "clausula_incentivo_desempeno": {
          "type": "object",
          "properties": {
            "valor": { "type": ["string", "boolean", "null"] },
            "detalle": {},
            "fuente": { "type": ["string", "null"] },
            "confianza": { "enum": ["alta", "media", "baja", null] }
          }
        },
        "clausula_multa_penalizacion": {
          "type": "object",
          "properties": {
            "valor": { "type": ["string", "boolean", "null"] },
            "detalle": {},
            "fuente": { "type": ["string", "null"] },
            "confianza": { "enum": ["alta", "media", "baja", null] }
          }
        },
        "mecanismo_reajuste_indexacion": {
          "type": "object",
          "properties": {
            "valor": { "type": ["string", "boolean", "null"] },
            "detalle": {},
            "fuente": { "type": ["string", "null"] },
            "confianza": { "enum": ["alta", "media", "baja", null] }
          }
        },
        "documentos_fuente": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notas": { "type": ["string", "null"] },
        "metadata_extraccion": { "type": ["object", "null"] }
      }
    }
  }
}
